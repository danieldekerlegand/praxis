# Python
.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Jupyter / launcher runtime
.jupyter/
# Learner progress (praxis/progress.py) — one file per learner, not shared state
.praxis/
*.DS_Store

# A user's own subjects and progress live on the active storage backend (see
# docs/storage.md), outside the repo. These two are the pre-storage locations and
# whatever PRAXIS_SUBJECTS_DIR/PRAXIS_PROGRESS_DIR may still point at — never tracked.
# notebooks/<NN-domain>/ (the seed library) stays tracked.
notebooks/subjects/

# Tauri shell build output
ui/node_modules/
ui/dist/
src-tauri/target/
src-tauri/gen/
# Chief runner state (only state/ is transient; config, verify.sh, agent-context.md are tracked)
.chief/state/
