# Python
.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Jupyter / launcher runtime
.jupyter/
# Learner progress (praxis/progress.py) — one file per learner, not shared state
.praxis/
*.DS_Store

# A user's own subjects and progress live on the active storage backend (see
# docs/reference/storage.md), outside the repo. These two are the pre-storage locations and
# whatever PRAXIS_SUBJECTS_DIR/PRAXIS_PROGRESS_DIR may still point at — never tracked.
# notebooks/<NN-domain>/ (the seed library) stays tracked.
notebooks/subjects/

# An author's working copy of a gate's questions (praxis/authored.py). The gate is
# <slug>.checks.json, which the shipped write path grades and writes; a tracked draft
# would be a second copy of the same questions with nothing keeping the two in sync.
*.checks.draft.json

# Tauri shell build output
ui/node_modules/
ui/dist/
src-tauri/target/
src-tauri/gen/
# Chief runner state (only state/ is transient; config, verify.sh, agent-context.md are tracked)
.chief/state/

# Staged by scripts/embed-python.sh: the Python runtime an embedded bundle carries.
# Hundreds of MB of downloaded interpreter and a copy of the core — built, never tracked.
# scripts/build-jupyterlite.sh writes the JupyterLite site (~72 MB) in here too.
src-tauri/resources/

# The isolated builder for that site: jupyterlite-core is a BUILD dependency of the
# site, never of the product (docs/reference/jupyterlite.md).
.lite-venv/
